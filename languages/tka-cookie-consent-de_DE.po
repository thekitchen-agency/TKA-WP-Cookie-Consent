#. Plugin Name of the plugin
#: tka-cookie-consent.php
msgid "TKA Cookie Consent"
msgstr "TKA Cookie Consent"

#. Description of the plugin
#: tka-cookie-consent.php
msgid ""
"A lightweight, modern cookie consent plugin compatible with the WP Consent "
"API standard."
msgstr ""
"Ein leichtgewichtiges, modernes Cookie-Einverständnis-Plugin, das mit dem WP-"
"Consent-API-Standard kompatibel ist."

#. Author of the plugin
#: tka-cookie-consent.php
msgid "TKA"
msgstr "TKA"

