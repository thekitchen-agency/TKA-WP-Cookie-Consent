#. Plugin Name of the plugin
#: tka-cookie-consent.php
msgid "TKA Cookie Consent"
msgstr "TKA Cookie Consent"

#. Description of the plugin
#: tka-cookie-consent.php
msgid ""
"A lightweight, modern cookie consent plugin compatible with the WP Consent "
"API standard."
msgstr ""
"Un plugin de consentement aux cookies léger et moderne, compatible avec le "
"standard WP Consent API."

#. Author of the plugin
#: tka-cookie-consent.php
msgid "TKA"
msgstr "TKA"

